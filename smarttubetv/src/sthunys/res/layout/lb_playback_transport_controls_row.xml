<?xml version="1.0" encoding="utf-8"?>
<!-- SmartTube Hunys: rândul de control al playerului ca la YouTube (aprobat în machete) -->
<!-- SmartTube Hunys: YouTube-like player controls row (as approved in the mockups) -->
<!-- Timpii deasupra barei: curent în stânga, total + rămas în dreapta. Sub bară: canal, Descriere,
     Abonează-te | ⏮ ▶ ⏭ în centru | like, dislike, ⚙, comentarii, playlist, CC pe sticlă. -->
<!-- Times above the bar: current left, total + remaining right. Below: channel, Description,
     Subscribe | prev/play/next centered | like, dislike, settings, comments, playlist, CC on glass. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/lb_playback_transport_control_row_padding_bottom" >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipToPadding="false"
            android:paddingStart="?attr/browsePaddingStart"
            android:paddingEnd="?attr/browsePaddingEnd"
            android:layout_marginBottom="@dimen/lb_playback_transport_control_info_margin_bottom"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/lb_playback_transport_image_height"
                android:layout_gravity="top"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/lb_playback_transport_image_margin_end"
                android:scaleType="fitStart" />

            <FrameLayout
                android:id="@+id/description_dock"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:clipToPadding="false"
                android:gravity="bottom" />

            <!-- Calitatea în dreapta sus, fără dată și oră / quality top right, no date and time -->
            <RelativeLayout android:id="@+id/additional_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginStart="16dp"
                            android:layoutDirection="ltr"
                            android:focusable="false" >
                <TextView
                    android:id="@+id/quality_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:alpha="0.7"
                    style="?attr/playbackControlsTimeStyle" />
                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
                    android:id="@+id/date_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@+id/quality_info"
                    android:visibility="gone"
                    style="?attr/playbackControlsTimeStyle" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/thumbs_row_wrapper"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/lb_playback_transport_thumbs_bottom_margin" >
            <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.seekpreview.ThumbsBar
                android:id="@+id/thumbs_row"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/thumbs_row_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Hello World!"
                style="?attr/playbackControlsTimeStyle" />
        </LinearLayout>
    </FrameLayout>

    <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/transport_row"
        android:orientation="vertical"
        android:paddingStart="?attr/browsePaddingStart"
        android:paddingEnd="?attr/browsePaddingEnd"
        android:clipChildren="false"
        android:clipToPadding="false" >

        <!-- MOD: hide player controls on UP button -->
        <LinearLayout android:id="@+id/top_edge"
                      android:orientation="horizontal"
                      android:layout_width="match_parent"
                      android:focusable="true"
                      android:layout_height="1dp"/>

        <!-- Repere: se deschid cu ↑ de pe bară (doar la clipurile cu capitole) -->
        <!-- Chapters: open with up from the bar (only for videos with chapters) -->
        <LinearLayout android:id="@+id/hunys_chapters_panel"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginBottom="10dp"
                      android:orientation="vertical"
                      android:clipChildren="false"
                      android:clipToPadding="false"
                      android:visibility="gone" >
            <TextView
                android:id="@+id/hunys_chapters_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:alpha="0.85"
                android:text="@string/hunys_chapters_hint"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp" />
            <HorizontalScrollView
                android:id="@+id/hunys_chapters_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" >
                <LinearLayout android:id="@+id/hunys_chapters_row"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:orientation="horizontal"
                              android:clipChildren="false"
                              android:clipToPadding="false" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Timpii / times -->
        <RelativeLayout android:id="@+id/time_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:layout_marginBottom="2dp"
                        android:focusable="false"
                        tools:ignore="RtlHardcoded" >
            <TextView
                android:id="@+id/current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textStyle="bold"
                style="?attr/playbackControlsTimeStyle" />

            <LinearLayout android:id="@+id/current_time_wrapper"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:layout_alignParentEnd="true"
                          android:orientation="horizontal"
                          android:focusable="false" >
                <TextView
                    android:id="@+id/separate_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/lb_playback_time_separator"
                    style="?attr/playbackControlsTimeStyle" />
                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    style="?attr/playbackControlsTimeStyle" />
                <TextView
                    android:id="@+id/ending_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:alpha="0.6"
                    style="?attr/playbackControlsTimeStyle" />
            </LinearLayout>
        </RelativeLayout>

        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.misc.SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_playback_transport_progressbar_height"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Butoanele: întâi ⏮ ▶ ⏭ (primesc focus primele), apoi rândul lat stânga | dreapta -->
        <!-- Buttons: prev/play/next first (they get focus first), then the wide left | right bar -->
        <RelativeLayout android:id="@+id/hunys_controls_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layoutDirection="ltr"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        tools:ignore="RtlHardcoded" >

            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <FrameLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </RelativeLayout>
    </com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView>
</LinearLayout>
