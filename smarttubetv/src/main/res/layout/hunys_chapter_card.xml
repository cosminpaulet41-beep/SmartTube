<?xml version="1.0" encoding="utf-8"?>
<!-- SmartTube Hunys: un reper (capitol) în rândul de deasupra barei / one chapter in the row above the bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="174dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/hunys_chapter_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33FFFFFF"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/hunys_chapter_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:background="@drawable/hunys_chapter_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/hunys_chapter_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:background="@drawable/hunys_chapter_now"
            android:text="@string/hunys_now"
            android:textColor="#FFFFFFFF"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/hunys_chapter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:duplicateParentState="true"
        android:minLines="3"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.05"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
